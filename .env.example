# Modèle de configuration locale — AUCUN SECRET ICI.
#
# 1. Copier ce fichier en `.env` (ignoré par Git) :   cp .env.example .env
# 2. Remplir les valeurs dans `.env`, jamais dans ce fichier.
# 3. Lancer les commandes avec :   uv run --env-file .env <commande>
#
# Ne jamais committer `.env`, ni coller la clé dans du code, un ticket ou un chat.

# URL de l'instance Dataiku DSS (ex. https://dataiku.mon-entreprise.fr)
DKU_DSS_URL=

# Clé d'API Dataiku personnelle (Profil > API keys), en lecture seule si possible
DKU_API_KEY=

# Poste derrière Zscaler / CA d'entreprise : bundle de certificats pour `requests`
# REQUESTS_CA_BUNDLE=C:\certs\bundle.pem
